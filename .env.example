# ==============================================================================
# OpsWingman Environment Configuration (.env.example)
# Copy this file to .env for local development.
# IMPORTANT: Never commit actual API keys or secrets to version control.
# ==============================================================================

# Project Settings
APP_NAME=OpsWingman
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Frontend Service
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL + pgvector Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=opswingman
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opswingman
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/opswingman

# Valkey / Cache & Queue
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_URL=redis://localhost:6379/0

# Mailpit (Local SMTP / Email Testing)
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Local LLM & Embeddings (Ollama)alembic check
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=llama3.1:8b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# Observability & Tracing (Langfuse Self-Hosted)
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder
LANGFUSE_SECRET_KEY=sk-lf-placeholder
LANGFUSE_ENABLE_TELEMETRY=false

# OpenTelemetry Settings
OTEL_SERVICE_NAME=opswingman-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Security & Tokens (Deterministic Controls)
APP_SECRET_KEY=change-this-insecure-secret-key-for-local-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
